{
  "manifest_version": 3,
  "name": "Auto English to Japanese",
  "version": "1.0.0",
  "description": "Type English in any text box and it is automatically replaced with Japanese. Click the icon to turn it on or off.",
  "permissions": ["storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Auto English → Japanese (click to toggle)" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
